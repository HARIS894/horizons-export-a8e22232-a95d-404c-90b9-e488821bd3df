NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_OTP_EXPIRES_MINUTES=15

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=instantcare-media

RESEND_API_KEY=
EMAIL_FROM=InstantCare <support@instantcare.in>
EMAIL_REPLY_TO=support@instantcare.in
SUPPORT_EMAIL=support@instantcare.in
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_MINUTES=15

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_DELAY_MINUTES=10

DEMO_ADMIN_EMAIL=admin@instantcare.com
DEMO_ADMIN_PASSWORD=admin123